<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nota_remision">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'NOTA DE REMISIÓN'"/><t t-set="esi_show_cost" t-value="True"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>
    <template id="report_entrega_consignacion">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE CONSIGNACIÓN'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>
    <template id="report_entrega_materiales">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE MATERIALES'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>
    <template id="report_recepcion_consignacion">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'RECEPCIÓN DE CONSIGNACIÓN'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>
    <template id="report_devolucion_proveedores">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCIÓN DE PROVEEDORES'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>
    <template id="report_devolucion_librerias">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCIÓN DE LIBRERÍAS'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t>
    </template>

    <!-- ESI corrección 2026-09-08: cabecera y diseño físico estable para HTML/PDF. -->
    <template id="esi_company_header">
        <t t-set="company" t-value="o.company_id"/>
        <table style="width:100%; border-collapse:collapse; border:0; table-layout:fixed; margin:0 0 2.5mm 0;">
            <tr style="height:23mm;">
                <td style="width:50%; vertical-align:top; border:0; padding:2mm 0 0 5mm;">
                    <img t-if="company.logo"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo"
                         style="max-height:16mm; max-width:42mm; width:auto; height:auto;"/>
                </td>
                <td style="width:50%; vertical-align:top; text-align:right; border:0; padding:1mm 4mm 0 0; font-size:8pt; line-height:1.45;">
                    <div style="font-weight:700; font-size:8.5pt;" t-esc="company.name or ''"/>
                    <div t-if="company.vat"><strong>NIT: </strong><span t-esc="company.vat"/></div>
                    <div t-if="company.phone"><strong>Tel: </strong><span t-esc="company.phone"/></div>
                    <div t-if="company.partner_id.city or company.partner_id.country_id">
                        <span t-esc="company.partner_id.city or ''"/>
                        <t t-if="company.partner_id.city and company.partner_id.country_id"> - </t>
                        <span t-esc="company.partner_id.country_id.name or ''"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_remision_body">
        <div class="page" style="width:100% !important; max-width:none !important; margin:0 !important; padding:0 !important; color:#000; font-family:Arial, Helvetica, sans-serif; font-size:8.5pt;">
            <t t-call="odoobo_remision_v13.esi_company_header"/>

            <div style="width:100%; text-align:center; margin:0 0 3.5mm 0;">
                <span style="font-size:11.5pt; font-weight:400; text-decoration:underline;" t-esc="esi_title"/>
            </div>

            <!-- ESI corrección: dos columnas mediante tabla fija para evitar que wkhtmltopdf las apile. -->
            <table style="width:92%; margin:0 auto 5mm auto; border-collapse:collapse; border:0; table-layout:fixed; font-size:8.5pt; line-height:1.45;">
                <colgroup>
                    <col style="width:12%;"/><col style="width:38%;"/><col style="width:14%;"/><col style="width:36%;"/>
                </colgroup>
                <tr>
                    <td style="border:0; padding:0.35mm 0;">FECHA:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.esi_date_in_words()"/></td>
                    <td style="border:0; padding:0.35mm 0;">WH_ORIGEN:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.location_id.display_name"/></td>
                </tr>
                <tr>
                    <td style="border:0; padding:0.35mm 0;">SEÑORES:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.partner_id.name or ''"/></td>
                    <td style="border:0; padding:0.35mm 0;">WH_DESTINO:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.location_dest_id.display_name"/></td>
                </tr>
                <tr>
                    <td style="border:0; padding:0.35mm 0;">NÚMERO:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.name"/></td>
                    <td style="border:0; padding:0.35mm 0;">PORCENTAJE:</td>
                    <td style="border:0; padding:0.35mm 1mm;"><strong t-esc="o.esi_percentage_label() or ''"/></td>
                </tr>
            </table>

            <!-- ESI corrección: IMPORTE TOTAL = CANTIDAD x PVP. COSTO se mantiene solo como dato unitario informativo. -->
            <table style="width:100% !important; max-width:none !important; margin:0; border-collapse:collapse; table-layout:fixed; font-size:7.4pt; line-height:1.25;">
                <thead>
                    <tr style="text-align:center; background:#e6e9ed; font-weight:700;">
                        <th style="width:12%; border:0.45pt solid #444; padding:1.15mm 0.8mm;">CANTIDAD</th>
                        <th style="border:0.45pt solid #444; padding:1.15mm 0.8mm;">TÍTULO</th>
                        <th style="width:14%; border:0.45pt solid #444; padding:1.15mm 0.8mm;">PVP</th>
                        <th t-if="esi_show_cost" style="width:14%; border:0.45pt solid #444; padding:1.15mm 0.8mm;">COSTO</th>
                        <th t-if="esi_show_cost" style="width:16%; border:0.45pt solid #444; padding:1.15mm 0.8mm;">IMPORTE TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.esi_report_moves()" t-as="line">
                        <td style="border:0.45pt solid #444; padding:1mm 0.8mm; text-align:center;" t-esc="o.esi_move_quantity(line)"/>
                        <td style="border:0.45pt solid #444; padding:1mm 0.8mm; word-wrap:break-word;" t-esc="line.product_id.display_name"/>
                        <td style="border:0.45pt solid #444; padding:1mm 0.8mm; text-align:right; white-space:nowrap;"><span t-esc="o.esi_unit_pvp(line)" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td>
                        <td t-if="esi_show_cost" style="border:0.45pt solid #444; padding:1mm 0.8mm; text-align:right; white-space:nowrap;"><span t-esc="o.esi_unit_cost(line)" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td>
                        <td t-if="esi_show_cost" style="border:0.45pt solid #444; padding:1mm 0.8mm; text-align:right; white-space:nowrap;"><span t-esc="o.esi_line_amount_total(line)" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="background:#e6e9ed; font-weight:700;">
                        <td style="border:0.45pt solid #444; padding:1.15mm 0.8mm; text-align:center;" t-esc="o.esi_total_quantity()"/>
                        <td colspan="2" style="border:0.45pt solid #444; padding:1.15mm 0.8mm;">TOTAL</td>
                        <td t-if="esi_show_cost" style="border:0.45pt solid #444; padding:1.15mm 0.8mm;"></td>
                        <td t-if="esi_show_cost" style="border:0.45pt solid #444; padding:1.15mm 0.8mm; text-align:right; white-space:nowrap;"><span t-esc="o.esi_total_amount()" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td>
                    </tr>
                </tfoot>
            </table>

            <table style="width:94%; margin:7mm auto 0 auto; border-collapse:collapse; border:0; table-layout:fixed; page-break-inside:avoid; font-size:8pt;">
                <tr style="height:40mm;">
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>ELABORADO</strong></td>
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>REVISADO</strong></td>
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>AUTORIZADO</strong></td>
                    <td style="width:46%; border:0; vertical-align:top; padding-left:5mm;">
                        <div style="text-align:center; font-weight:700; margin-bottom:8mm;">CONFORMIDAD</div>
                        <table style="width:100%; border-collapse:collapse; border:0; font-size:8pt;">
                            <tr><td style="width:24%; border:0; padding:0 0 4mm 0;">Firma:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:0 0 4mm 0;"></td></tr>
                            <tr><td style="border:0; padding:4mm 0;">Aclaración:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:4mm 0;"></td></tr>
                            <tr><td style="border:0; padding:4mm 0 0 0;">Documento:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:4mm 0 0 0;"></td></tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>
