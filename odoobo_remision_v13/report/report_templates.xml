<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_nota_remision"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'NOTA DE REMISIÓN'"/><t t-set="esi_show_cost" t-value="True"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_entrega_consignacion"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE CONSIGNACIÓN'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_entrega_materiales"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE MATERIALES'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_recepcion_consignacion"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'RECEPCIÓN DE CONSIGNACIÓN'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_devolucion_proveedores"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCIÓN DE PROVEEDORES'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_devolucion_librerias"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCIÓN DE LIBRERÍAS'"/><t t-set="esi_show_cost" t-value="False"/><t t-call="odoobo_remision_v13.report_remision_body"/></t></t></template>
  <template id="report_remision_body"><t t-call="web.external_layout"><div class="page" style="font-size:11px;color:#000;"><h3 style="text-align:center;text-decoration:underline;margin:8px 0 12px;" t-esc="esi_title"/><div class="row" style="margin-bottom:14px;"><div class="col-6"><table style="width:100%;"><tr><td style="width:28%;">FECHA:</td><td><strong t-esc="o.esi_date_in_words()"/></td></tr><tr><td>SEÑORES:</td><td><strong t-esc="o.partner_id.name or ''"/></td></tr><tr><td>NÚMERO:</td><td><strong t-esc="o.name"/></td></tr></table></div><div class="col-6"><table style="width:100%;"><tr><td style="width:32%;">WH_ORIGEN:</td><td><strong t-esc="o.location_id.display_name"/></td></tr><tr><td>WH_DESTINO:</td><td><strong t-esc="o.location_dest_id.display_name"/></td></tr><tr t-if="o.esi_percentage_label()"><td>PORCENTAJE:</td><td><strong t-esc="o.esi_percentage_label()"/></td></tr></table></div></div><table class="table table-sm table-bordered" style="width:100%;table-layout:fixed;font-size:10px;"><thead><tr style="text-align:center;background:#e9ecef;"><th style="width:12%;">CANTIDAD</th><th>TÍTULO</th><th style="width:14%;">PVP</th><th t-if="esi_show_cost" style="width:14%;">COSTO</th><th t-if="esi_show_cost" style="width:16%;">IMPORTE TOTAL</th></tr></thead><tbody><tr t-foreach="o.esi_report_moves()" t-as="line"><td style="text-align:center;" t-esc="o.esi_move_quantity(line)"/><td t-esc="line.product_id.display_name"/><td style="text-align:right;"><span t-field="line.product_id.lst_price"/></td><td t-if="esi_show_cost" style="text-align:right;"><span t-esc="o.esi_unit_cost(line)" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td><td t-if="esi_show_cost" style="text-align:right;"><span t-esc="o.esi_line_cost_total(line)" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td></tr></tbody><tfoot><tr style="background:#e9ecef;font-weight:bold;"><td style="text-align:center;" t-esc="o.esi_total_quantity()"/><td t-att-colspan="2 if esi_show_cost else 2">TOTAL</td><td t-if="esi_show_cost"></td><td t-if="esi_show_cost" style="text-align:right;"><span t-esc="o.esi_total_cost()" t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td></tr></tfoot></table><div class="row" style="height:150px;margin-top:15px;page-break-inside:avoid;"><div class="col-2" style="padding-top:120px;text-align:center;"><strong>ELABORADO</strong></div><div class="col-2" style="padding-top:120px;text-align:center;"><strong>REVISADO</strong></div><div class="col-2" style="padding-top:120px;text-align:center;"><strong>AUTORIZADO</strong></div><div class="col-6"><div style="text-align:center;font-weight:bold;">CONFORMIDAD</div><div style="margin-top:28px;">Firma: ______________________________</div><div style="margin-top:18px;">Aclaración: __________________________</div><div style="margin-top:18px;">Documento: __________________________</div></div></div></div></t></template>
</odoo>

