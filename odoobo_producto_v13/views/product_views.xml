<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESI corrección: se usan XPath robustos para no depender de que default_code exista en la vista padre. -->
    <record id="product_template_form_esi_fields" model="ir.ui.view">
        <field name="name">product.template.form.esi.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Datos adicionales ESI" name="esi_additional_fields">
                    <group>
                        <group>
                            <field name="esi_extra_field_1"/>
                            <field name="esi_extra_field_2"/>
                            <field name="esi_extra_field_3"/>
                        </group>
                        <group>
                            <field name="esi_extra_field_4"/>
                            <field name="esi_extra_field_5"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_esi_fields" model="ir.ui.view">
        <field name="name">product.product.form.esi.fields</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Datos adicionales ESI" name="esi_additional_fields">
                    <group>
                        <group>
                            <field name="esi_extra_field_1"/>
                            <field name="esi_extra_field_2"/>
                            <field name="esi_extra_field_3"/>
                        </group>
                        <group>
                            <field name="esi_extra_field_4"/>
                            <field name="esi_extra_field_5"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ESI corrección: agregar al final del tree evita fallos por vistas personalizadas sin default_code. -->
    <record id="product_template_tree_esi_fields" model="ir.ui.view">
        <field name="name">product.template.tree.esi.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="esi_extra_field_1" optional="hide"/>
                <field name="esi_extra_field_2" optional="hide"/>
                <field name="esi_extra_field_3" optional="hide"/>
                <field name="esi_extra_field_4" optional="hide"/>
                <field name="esi_extra_field_5" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_esi_fields" model="ir.ui.view">
        <field name="name">product.product.tree.esi.fields</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="esi_extra_field_1" optional="hide"/>
                <field name="esi_extra_field_2" optional="hide"/>
                <field name="esi_extra_field_3" optional="hide"/>
                <field name="esi_extra_field_4" optional="hide"/>
                <field name="esi_extra_field_5" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ESI corrección principal del error de instalación mostrado por el cliente. -->
    <record id="product_product_search_esi_fields" model="ir.ui.view">
        <field name="name">product.product.search.esi.fields</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="esi_extra_field_1"/>
                <field name="esi_extra_field_2"/>
                <field name="esi_extra_field_3"/>
                <field name="esi_extra_field_4"/>
                <field name="esi_extra_field_5"/>
            </xpath>
        </field>
    </record>
</odoo>
