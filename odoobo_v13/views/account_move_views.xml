<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_esi_comprobante" model="ir.ui.view">
        <field name="name">account.move.form.esi.comprobante</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_esi_comprobante_preview" type="object" string="Vista comprobante" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'posted')]}" groups="account.group_account_invoice,account.group_account_user"/>
                <button name="action_esi_comprobante_pdf" type="object" string="PDF comprobante" attrs="{'invisible': [('state', '!=', 'posted')]}" groups="account.group_account_invoice,account.group_account_user"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Comprobante Contable" name="esi_comprobante_options" groups="account.group_account_invoice,account.group_account_user">
                    <field name="esi_check_number"/>
                    <field name="esi_show_line_date"/>
                    <field name="esi_show_analytic"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

