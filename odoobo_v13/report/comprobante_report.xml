<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_comprobante_contable" model="report.paperformat">
        <field name="name">ESI Comprobante Contable Carta</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field><field name="margin_bottom">10</field>
        <field name="margin_left">7</field><field name="margin_right">7</field>
        <field name="header_line" eval="False"/><field name="dpi">96</field>
    </record>
    <record id="action_comprobante_contable_pdf" model="ir.actions.report">
        <field name="name">Comprobante Contable (PDF)</field><field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">odoobo_v13.comprobante_contable_document</field>
        <field name="report_file">odoobo_v13.comprobante_contable_document</field><field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_comprobante_contable"/>
        <field name="print_report_name">object.esi_report_filename()</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
    </record>
    <record id="action_comprobante_contable_html" model="ir.actions.report">
        <field name="name">Comprobante Contable (Vista)</field><field name="model">account.move</field>
        <field name="report_type">qweb-html</field><field name="report_name">odoobo_v13.comprobante_contable_document</field>
        <field name="report_file">odoobo_v13.comprobante_contable_document</field>
        <field name="paperformat_id" ref="paperformat_comprobante_contable"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
    </record>
</odoo>

