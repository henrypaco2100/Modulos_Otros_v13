<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_productivity_tree" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.esi.tree</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="arch" type="xml">
            <tree string="Partes de Producción ESI" create="1" edit="1">
                <field name="company_id" invisible="1"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="workcenter_id"/>
                <field name="esi_area"/>
                <field name="esi_operator_id"/>
                <field name="duration" widget="float_time"/>
                <field name="esi_qty_processed"/>
                <field name="esi_piece_rate"/>
                <field name="esi_piece_amount"/>
                <field name="loss_id"/>
            </tree>
        </field>
    </record>
    <record id="view_esi_productivity_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.productivity.esi.form</field>
        <field name="model">mrp.workcenter.productivity</field>
        <field name="arch" type="xml">
            <form string="Parte de Producción ESI">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="workorder_id"/>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id"/>
                            <field name="loss_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration" readonly="1" widget="float_time"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="ESI - Destajo">
                        <field name="esi_operator_id"/>
                        <field name="esi_area"/>
                        <field name="esi_qty_processed"/>
                        <field name="esi_piece_rate"/>
                        <field name="esi_piece_amount" readonly="1"/>
                        <field name="esi_source"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_esi_productivity" model="ir.actions.act_window">
        <field name="name">Partes de Producción ESI</field>
        <field name="res_model">mrp.workcenter.productivity</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="view_id" ref="view_esi_productivity_tree"/>
        <field name="domain">[('workorder_id','!=',False)]</field>
    </record>
    <menuitem id="menu_esi_productivity" name="Partes de Producción ESI" parent="mrp.menu_mrp_reporting" action="action_esi_productivity" sequence="24" groups="mrp.group_mrp_manager"/>
</odoo>
