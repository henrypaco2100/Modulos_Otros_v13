<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_esi_mrp_operator_company" model="ir.rule">
        <field name="name">Operadores ESI por compañía</field>
        <field name="model_id" ref="model_esi_mrp_operator"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="rule_esi_mrp_piecework_note_company" model="ir.rule">
        <field name="name">Apuntes de destajo ESI por compañía</field>
        <field name="model_id" ref="model_esi_mrp_piecework_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
</odoo>
