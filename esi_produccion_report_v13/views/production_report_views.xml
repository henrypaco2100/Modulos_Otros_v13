<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_production_report_wizard_form" model="ir.ui.view">
        <field name="name">esi.production.report.wizard.form</field>
        <field name="model">esi.production.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Informes de Producción ESI">
                <sheet>
                    <group>
                        <group string="Informe">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="report_type"/>
                            <field name="group_by"/>
                            <field name="state_filter"/>
                            <field name="date_basis"/>
                        </group>
                        <group string="Período">
                            <field name="period_mode"/>
                            <field name="date_from" attrs="{'invisible': [('period_mode', '!=', 'range')], 'required': [('period_mode', '=', 'range')]}"/>
                            <field name="date_to" attrs="{'invisible': [('period_mode', '!=', 'range')], 'required': [('period_mode', '=', 'range')]}"/>
                            <field name="day_date" attrs="{'invisible': [('period_mode', '!=', 'day')]}"/>
                            <field name="month" attrs="{'invisible': [('period_mode', '!=', 'month')]}"/>
                            <field name="year" attrs="{'invisible': [('period_mode', 'not in', ('month', 'year'))]}"/>
                        </group>
                    </group>
                    <group string="Filtros opcionales" col="2">
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <separator string="Vista previa" attrs="{'invisible': [('preview_html', '=', False)]}"/>
                    <field name="preview_html" nolabel="1" attrs="{'invisible': [('preview_html', '=', False)]}"/>
                    <field name="excel_file" invisible="1"/>
                    <field name="excel_filename" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_view_report" type="object" string="Ver" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Descargar PDF" class="btn-secondary"/>
                    <button name="action_export_excel" type="object" string="Descargar Excel" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_esi_production_report" model="ir.actions.act_window">
        <field name="name">Informes de Producción</field>
        <field name="res_model">esi.production.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esi_production_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_esi_production_report"
              name="Informes de Producción"
              parent="mrp.menu_mrp_reporting"
              action="action_esi_production_report"
              sequence="25"
              groups="mrp.group_mrp_user"/>


    <!-- ESI mejora: vista completa del análisis individual, sin descarga automática. -->
    <record id="view_esi_production_detail_wizard_form" model="ir.ui.view">
        <field name="name">esi.production.detail.wizard.form</field>
        <field name="model">esi.production.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Análisis de Producción ESI" create="0" edit="0">
                <header>
                    <button name="action_print_pdf" type="object" string="Descargar PDF" class="oe_highlight" icon="fa-file-pdf-o"/>
                    <button name="action_export_excel" type="object" string="Descargar Excel" icon="fa-file-excel-o"/>
                    <button name="action_refresh_preview" type="object" string="Actualizar" icon="fa-refresh"/>
                    <button name="action_back_to_production" type="object" string="Volver a Producción" icon="fa-arrow-left"/>
                </header>
                <sheet>
                    <group>
                        <field name="production_id" readonly="1"/>
                    </group>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <field name="excel_file" invisible="1"/>
                    <field name="excel_filename" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ESI mejora: botón estadístico con el mismo estilo de Movimientos de productos / Valoración. -->
    <record id="view_mrp_production_form_esi_analysis" model="ir.ui.view">
        <field name="name">mrp.production.form.esi.analysis</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_esi_production_analysis"
                        type="object"
                        string="Análisis Producción"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        groups="mrp.group_mrp_user"/>
            </xpath>
        </field>
    </record>

</odoo>
