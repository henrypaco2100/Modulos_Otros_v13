<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_destajo_report_wizard_form" model="ir.ui.view">
        <field name="name">esi.destajo.report.wizard.form</field>
        <field name="model">esi.destajo.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Destajos">
                <sheet>
                    <group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Filtros">
                            <field name="product_tmpl_id"/>
                            <field name="partner_id"/>
                            <field name="activity_id"/>
                            <field name="state_filter"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Los destajos son gastos independientes de sueldos/extras y ya no están vinculados a una orden de producción.
                    </div>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Generar reporte" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_esi_destajo_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Destajos</field>
        <field name="res_model">esi.destajo.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esi_destajo_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_esi_destajo_report"
              name="Reporte de Destajos"
              parent="mrp.menu_mrp_reporting"
              action="action_esi_destajo_report_wizard"
              sequence="27"
              groups="mrp.group_mrp_user"/>
</odoo>
