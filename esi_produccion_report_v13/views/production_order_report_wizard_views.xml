<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_production_order_report_wizard_form" model="ir.ui.view">
        <field name="name">esi.production.order.report.wizard.form</field>
        <field name="model">esi.production.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportes por Orden de Producción">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="production_id"/>
                        <field name="report_type"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        La ficha de costo utiliza el costo capturado en la OF y, cuando existe valoración automática,
                        muestra también el costo real de los movimientos contabilizados.
                    </div>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Generar PDF" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_esi_production_order_report_wizard" model="ir.actions.act_window">
        <field name="name">Reportes por Orden de Producción</field>
        <field name="res_model">esi.production.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esi_production_order_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_esi_production_order_reports"
              name="Reportes por Orden de Producción"
              parent="mrp.menu_mrp_reporting"
              action="action_esi_production_order_report_wizard"
              sequence="26"
              groups="mrp.group_mrp_user"/>
</odoo>
