<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_esi_calzado_landscape" model="report.paperformat">
        <field name="name">ESI Calzado A4 Horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">4</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_esi_production_cost" model="ir.actions.report">
        <field name="name">ESI - Ficha de costo de producción</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_produccion_report_v13.report_esi_production_cost_document</field>
        <field name="report_file">esi_produccion_report_v13.report_esi_production_cost_document</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_esi_calzado_landscape"/>
        <field name="print_report_name">'Costo_Produccion_%s' % (object.name or '')</field>
    </record>

    <record id="action_report_esi_material_shortage" model="ir.actions.report">
        <field name="name">ESI - Faltantes de materiales y costo</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_produccion_report_v13.report_esi_material_shortage_document</field>
        <field name="report_file">esi_produccion_report_v13.report_esi_material_shortage_document</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_esi_calzado_landscape"/>
        <field name="print_report_name">'Faltantes_%s' % (object.name or '')</field>
    </record>

    <record id="action_report_esi_destajo_mo" model="ir.actions.report">
        <field name="name">ESI - Resumen de destajos</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_produccion_report_v13.report_esi_destajo_mo_document</field>
        <field name="report_file">esi_produccion_report_v13.report_esi_destajo_mo_document</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_esi_calzado_landscape"/>
        <field name="print_report_name">'Destajos_%s' % (object.name or '')</field>
    </record>

    <record id="action_report_esi_destajo_global" model="ir.actions.report">
        <field name="name">Reporte de Destajos ESI</field>
        <field name="model">esi.destajo.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">esi_produccion_report_v13.report_esi_destajo_global_document</field>
        <field name="report_file">esi_produccion_report_v13.report_esi_destajo_global_document</field>
        <field name="paperformat_id" ref="paperformat_esi_calzado_landscape"/>
        <field name="print_report_name">'Reporte_Destajos_ESI'</field>
    </record>

    <template id="esi_report_header">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;">
            <div>
                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:55px;max-width:190px;"/>
            </div>
            <div style="text-align:right;font-size:9px;">
                <strong t-esc="company.display_name"/><br/>
                <span t-esc="company.vat or ''"/>
            </div>
        </div>
    </template>

    <template id="report_esi_production_cost_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="rows" t-value="o.esi_report_material_rows()"/>
                <t t-set="tot" t-value="o.esi_report_cost_summary()"/>
                <div class="page" style="font-family:Arial,sans-serif;font-size:8px;">
                    <t t-call="esi_produccion_report_v13.esi_report_header"/>
                    <h2 style="text-align:center;color:#072955;margin:4px 0 8px 0;">FICHA DE COSTO DE PRODUCCIÓN</h2>
                    <table style="width:100%;margin-bottom:7px;font-size:8px;">
                        <tr>
                            <td><strong>OF:</strong> <span t-esc="o.name"/></td>
                            <td><strong>Producto:</strong> <span t-esc="o.product_id.display_name"/></td>
                            <td><strong>Cantidad:</strong> <span t-esc="'%.2f' % o.product_qty"/> <span t-esc="o.product_uom_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Variante:</strong> <span t-esc="o.esi_variant_info or '-'"/></td>
                            <td><strong>Analítica:</strong> <span t-esc="o.esi_analytic_account_id.display_name or '-'"/></td>
                            <td><strong>Estado:</strong> <span t-esc="o.state"/></td>
                        </tr>
                    </table>
                    <table style="border-collapse:collapse;width:100%;font-size:7.4px;">
                        <thead>
                            <tr style="background:#072955;color:white;">
                                <th style="border:1px solid #8ca0b3;padding:4px;">DETALLE</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">MATERIAL</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">CANT./UNID.</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">UDM</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">COSTO UNIT.</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">COSTO MAT./UNID.</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">CANT. TOTAL</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">COSTO EST.</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">CANT. REAL</th>
                                <th style="border:1px solid #8ca0b3;padding:4px;">COSTO REAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="r">
                                <td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['group']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['product']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.4f' % r['qty_per_unit']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:center;"><span t-esc="r['uom']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['unit_cost']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['unit_material_cost']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['planned_qty']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['planned_cost']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['actual_qty']"/></td>
                                <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['actual_cost']"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="margin-top:8px;display:flex;justify-content:flex-end;">
                        <table style="border-collapse:collapse;width:46%;font-size:8px;">
                            <tr><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Material estimado</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['material_estimated']"/></td></tr>
                            <tr><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Destajos registrados</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['destajo_all']"/></td></tr>
                            <tr><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Total estimado OF</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['estimated_total']"/></td></tr>
                            <tr><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Costo estimado / unidad</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['estimated_unit']"/></td></tr>
                            <tr t-if="tot['finished_valuation']"><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Valoración automática producto terminado</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['finished_valuation']"/></td></tr>
                            <tr t-if="tot['finished_valuation']"><td style="border:1px solid #ccd5dd;padding:4px;"><strong>Valorado / unidad</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;">Bs <span t-esc="'%.2f' % tot['finished_valuation_unit']"/></td></tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_esi_material_shortage_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="rows" t-value="o.esi_report_shortage_rows()"/>
                <div class="page" style="font-family:Arial,sans-serif;font-size:8px;">
                    <t t-call="esi_produccion_report_v13.esi_report_header"/>
                    <h2 style="text-align:center;color:#072955;margin:4px 0 8px 0;">FALTANTES DE MATERIALES Y COSTO</h2>
                    <p><strong>Orden de fabricación:</strong> <span t-esc="o.name"/> | <strong>Producto:</strong> <span t-esc="o.product_id.display_name"/> | <strong>Cantidad:</strong> <span t-esc="'%.2f' % o.product_qty"/> <span t-esc="o.product_uom_id.name"/></p>
                    <p style="font-size:7.5px;">Documento para que el encargado de producción solicite o prepare la compra de los materiales que no están disponibles para la OF.</p>
                    <t t-if="not rows"><div style="border:1px solid #009846;padding:18px;text-align:center;">No existen faltantes según la disponibilidad actual.</div></t>
                    <table t-if="rows" style="border-collapse:collapse;width:100%;font-size:7.6px;">
                        <thead><tr style="background:#072955;color:white;">
                            <th style="border:1px solid #8ca0b3;padding:4px;">MATERIAL</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">REQUERIDO</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">DISPONIBLE</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">FALTANTE</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">UDM</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">PROVEEDOR SUGERIDO</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">COSTO UNIT. EST.</th>
                            <th style="border:1px solid #8ca0b3;padding:4px;">COSTO FALTANTE</th>
                        </tr></thead>
                        <tbody><tr t-foreach="rows" t-as="r">
                            <td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['product']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['planned_qty']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['available_qty']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><strong t-esc="'%.2f' % r['missing_qty']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:center;"><span t-esc="r['uom']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['supplier'] or '-'"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;">Bs <span t-esc="'%.2f' % r['purchase_unit_cost']"/></td>
                            <td style="border:1px solid #ccd5dd;padding:3px;text-align:right;">Bs <strong t-esc="'%.2f' % r['missing_cost']"/></td>
                        </tr></tbody>
                        <tfoot><tr style="background:#eef4fa;"><td colspan="7" style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>TOTAL COSTO ESTIMADO FALTANTE</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % sum([r['missing_cost'] for r in rows])"/></strong></td></tr></tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_esi_destajo_mo_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="summary" t-value="o.esi_report_destajo_summary()"/>
                <t t-set="rows" t-value="o.esi_report_destajo_rows()"/>
                <div class="page" style="font-family:Arial,sans-serif;font-size:8px;">
                    <t t-call="esi_produccion_report_v13.esi_report_header"/>
                    <h2 style="text-align:center;color:#072955;margin:4px 0 8px 0;">RESUMEN DE DESTAJOS</h2>
                    <p><strong>OF:</strong> <span t-esc="o.name"/> | <strong>Producto:</strong> <span t-esc="o.product_id.display_name"/> | <strong>Variante:</strong> <span t-esc="o.esi_variant_info or '-'"/></p>
                    <h3 style="color:#072955;">Resumen por trabajador</h3>
                    <table style="border-collapse:collapse;width:100%;font-size:8px;margin-bottom:8px;">
                        <thead><tr style="background:#eef4fa;color:#072955;"><th style="border:1px solid #ccd5dd;padding:4px;">TRABAJADOR</th><th style="border:1px solid #ccd5dd;padding:4px;">REGISTROS</th><th style="border:1px solid #ccd5dd;padding:4px;">CANTIDAD</th><th style="border:1px solid #ccd5dd;padding:4px;">TOTAL DESTAJO</th></tr></thead>
                        <tbody><tr t-foreach="summary" t-as="s"><td style="border:1px solid #ccd5dd;padding:4px;"><span t-esc="s['worker']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:center;"><span t-esc="s['records']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><span t-esc="'%.2f' % s['quantity']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % s['amount']"/></strong></td></tr></tbody>
                        <tfoot><tr style="background:#f5f7f9;"><td style="border:1px solid #ccd5dd;padding:4px;"><strong>TOTAL GENERAL</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:center;"><strong t-esc="len(rows)"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong t-esc="'%.2f' % sum([x['quantity'] for x in rows])"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % sum([x['amount'] for x in rows])"/></strong></td></tr></tfoot>
                    </table>
                    <h3 style="color:#072955;">Reporte detallado</h3>
                    <table style="border-collapse:collapse;width:100%;font-size:7.5px;">
                        <thead><tr style="background:#072955;color:white;"><th style="border:1px solid #8ca0b3;padding:4px;">FECHA</th><th style="border:1px solid #8ca0b3;padding:4px;">TRABAJADOR</th><th style="border:1px solid #8ca0b3;padding:4px;">ACTIVIDAD</th><th style="border:1px solid #8ca0b3;padding:4px;">DETALLE</th><th style="border:1px solid #8ca0b3;padding:4px;">CANTIDAD</th><th style="border:1px solid #8ca0b3;padding:4px;">UDM</th><th style="border:1px solid #8ca0b3;padding:4px;">PRECIO/UNID.</th><th style="border:1px solid #8ca0b3;padding:4px;">TOTAL</th><th style="border:1px solid #8ca0b3;padding:4px;">ESTADO</th></tr></thead>
                        <tbody><tr t-foreach="rows" t-as="r"><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['date']"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['worker']"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['activity']"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['description']"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % r['quantity']"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['uom']"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;">Bs <span t-esc="'%.2f' % r['unit_price']"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % r['amount']"/></strong></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="r['state']"/></td></tr></tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_esi_destajo_global_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="w">
                <t t-set="company" t-value="w.company_id"/>
                <t t-set="lines" t-value="w.esi_get_destajos()"/>
                <t t-set="summary" t-value="w.esi_get_summary()"/>
                <div class="page" style="font-family:Arial,sans-serif;font-size:8px;">
                    <t t-call="esi_produccion_report_v13.esi_report_header"/>
                    <h2 style="text-align:center;color:#072955;margin:4px 0 8px 0;">REPORTE DE DESTAJOS</h2>
                    <p><strong>Producto:</strong> <span t-esc="w.product_tmpl_id.display_name or 'Todos'"/> | <strong>OF:</strong> <span t-esc="w.production_id.name or 'Todas'"/> | <strong>Operador:</strong> <span t-esc="w.partner_id.display_name or 'Todos'"/></p>
                    <h3 style="color:#072955;">Resumen por trabajador</h3>
                    <table style="border-collapse:collapse;width:100%;font-size:8px;margin-bottom:8px;">
                        <thead><tr style="background:#eef4fa;color:#072955;"><th style="border:1px solid #ccd5dd;padding:4px;">TRABAJADOR</th><th style="border:1px solid #ccd5dd;padding:4px;">REGISTROS</th><th style="border:1px solid #ccd5dd;padding:4px;">TOTAL CANTIDAD</th><th style="border:1px solid #ccd5dd;padding:4px;">TOTAL DESTAJO</th></tr></thead>
                        <tbody><tr t-foreach="summary" t-as="s"><td style="border:1px solid #ccd5dd;padding:4px;"><span t-esc="s['worker']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:center;"><span t-esc="s['records']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><span t-esc="'%.2f' % s['quantity']"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % s['amount']"/></strong></td></tr></tbody>
                        <tfoot><tr style="background:#f5f7f9;"><td style="border:1px solid #ccd5dd;padding:4px;"><strong>TOTAL GENERAL</strong></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:center;"><strong t-esc="len(lines)"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong t-esc="'%.2f' % sum(lines.mapped('quantity'))"/></td><td style="border:1px solid #ccd5dd;padding:4px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % sum(lines.mapped('amount'))"/></strong></td></tr></tfoot>
                    </table>
                    <h3 style="color:#072955;">Reporte detallado</h3>
                    <table style="border-collapse:collapse;width:100%;font-size:7.3px;">
                        <thead><tr style="background:#072955;color:white;"><th style="border:1px solid #8ca0b3;padding:4px;">FECHA</th><th style="border:1px solid #8ca0b3;padding:4px;">TRABAJADOR</th><th style="border:1px solid #8ca0b3;padding:4px;">ORDEN</th><th style="border:1px solid #8ca0b3;padding:4px;">PRODUCTO</th><th style="border:1px solid #8ca0b3;padding:4px;">ACTIVIDAD</th><th style="border:1px solid #8ca0b3;padding:4px;">CANTIDAD</th><th style="border:1px solid #8ca0b3;padding:4px;">UDM</th><th style="border:1px solid #8ca0b3;padding:4px;">PRECIO/UNID.</th><th style="border:1px solid #8ca0b3;padding:4px;">TOTAL</th><th style="border:1px solid #8ca0b3;padding:4px;">ESTADO</th></tr></thead>
                        <tbody><tr t-foreach="lines" t-as="l"><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.date"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.partner_id.display_name"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.production_id.name"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.product_id.display_name"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.activity_id.name"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><span t-esc="'%.2f' % l.quantity"/></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="l.uom_id.name"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;">Bs <span t-esc="'%.2f' % l.unit_price"/></td><td style="border:1px solid #ccd5dd;padding:3px;text-align:right;"><strong>Bs <span t-esc="'%.2f' % l.amount"/></strong></td><td style="border:1px solid #ccd5dd;padding:3px;"><span t-esc="dict(l._fields['state'].selection).get(l.state, l.state)"/></td></tr></tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
