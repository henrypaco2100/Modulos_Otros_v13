<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esi_demo_calzado_wizard_form" model="ir.ui.view">
        <field name="name">esi.demo.calzado.promedio.wizard.form</field>
        <field name="model">esi.demo.calzado.promedio.wizard</field>
        <field name="arch" type="xml">
            <form string="Demo ESI - Fábrica de Calzado AVCO">
                <group>
                    <div class="alert alert-info" role="alert" colspan="2">
                        Crea o actualiza una compañía DEMO aislada con método de coste Promedio (AVCO). Dos compras se reciben automáticamente para formar el costo promedio y una tercera queda pendiente para demostrar el recálculo en vivo. Incluye plan contable, ventas, fabricación, operaciones, tiempos y destajo.
                    </div>
                    <field name="result" nolabel="1" readonly="1" placeholder="Aquí se mostrará el resumen de la carga."/>
                </group>
                <footer>
                    <button name="action_run" string="Cargar / Actualizar Demo" type="object" class="btn-primary" groups="mrp.group_mrp_manager"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_esi_demo_calzado_wizard" model="ir.actions.act_window">
        <field name="name">Cargar Demo Calzado ESI AVCO</field>
        <field name="res_model">esi.demo.calzado.promedio.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_esi_demo_calzado_wizard"
              name="Cargar Demo Calzado ESI AVCO"
              parent="mrp.menu_mrp_configuration"
              action="action_esi_demo_calzado_wizard"
              sequence="95"
              groups="mrp.group_mrp_manager"/>
</odoo>
