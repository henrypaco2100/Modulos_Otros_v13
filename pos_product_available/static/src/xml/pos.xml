<templates id="template" xml:space="preserve">
    <t t-extend="Product">
        <t t-jquery=".product" t-operation="replace">
            <article t-attf-class="product #{product.sd_qty_available lte 0 and product.type == 'product' ? 'disable':''}" t-att-data-product-id="product.id" tabindex="0" t-attf-aria-labelledby="article_product_#{product.id}">
                <div class="product-img">
                    <img t-att-src='image_url' alt="Product image"/>
                    <t t-if="!product.to_weight">
                        <span class="price-tag">
                            <t t-esc="widget.format_currency(product.get_display_price(pricelist, 1),'Product Price')"/>
                        </span>
                    </t>
                    <t t-if="product.to_weight">
                        <span class="price-tag">
                            <t t-esc="widget.format_currency(product.get_price(pricelist, 1),'Product Price')+'/'+widget.pos.units_by_id[product.uom_id[0]].name"/>
                        </span>
                    </t>
                    <t t-if="widget.pos.config.show_qtys &amp;&amp; product.type == 'product'">
                        <span
                            t-attf-class="qty-tag #{product.sd_qty_available lte 0 ? 'not-available':''}"
                        >
                            <t t-esc="product.rounded_qty()" />
                        </span>
                    </t>
                </div>
                <div class="product-name" t-attf-id="article_product_#{product.id}">
                    <t t-esc="product.display_name"/>
                </div>
            </article>
        </t>
<!--        <t t-jquery=".product-img" t-operation="append">-->
<!--            <t t-if="widget.pos.config.show_qtys &amp;&amp; product.type == 'product'">-->
<!--                <span-->
<!--                    t-attf-class="qty-tag #{product.sd_qty_available lte 0 ? 'not-available':''}"-->
<!--                >-->
<!--                    <t t-esc="product.rounded_qty()" />-->
<!--                </span>-->
<!--            </t>-->
<!--        </t>-->
    </t>
    <t t-extend="Orderline">
        <t t-jquery=".info-list>t:first-child">
            this.attr('t-if', "line.get_quantity_str() !== '1' || line.selected || line.get_product().sd_qty_available lt line.quantity ");
        </t>
        <t t-jquery="t[t-esc='line.get_quantity_str()']" t-operation="after">
            <t
                t-if="widget.pos.config.show_qtys &amp;&amp; line.get_product().type == 'product'"
            >
                <t t-set='qty_available' t-value='line.get_product().sd_qty_available' />
                (of <span
                    t-attf-class="qty-info #{sd_qty_available lt line.quantity ? 'not-available':''}"
                >
                    <t t-esc="line.get_product().rounded_qty()" />
                </span>)
            </t>
        </t>
    </t>
